{
  "name": "orient-computers",
  "version": "1.0.0",
  "description": "Orient Computers & Engineering E-Commerce Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "start": "npm --prefix server start",
    "build": "npm --prefix client run build",
    "install-all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "ecommerce",
    "react",
    "express",
    "mongodb",
    "tailwind"
  ],
  "author": "Orient Computers & Engineering",
  "license": "ISC"
}
